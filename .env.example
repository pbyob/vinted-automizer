# Auswahl des Standard-KI-Backends: "ollama" (lokal) oder "gemini" (Google Cloud)
AI_PROVIDER=ollama

# --- Option A: Lokales Modell über Ollama (kostenlos & offline) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:8b

# --- Option B: Google Cloud Gemini Vision API ---
GEMINI_API_KEY=dein_api_key_hier
GEMINI_MODEL=gemini-3.8-flash
